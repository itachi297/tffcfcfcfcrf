  <script>
    const filters=[...document.querySelectorAll('.filter')];
    filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(item=>item.classList.remove('active'));button.classList.add('active');const family=button.dataset.filter;document.querySelectorAll('.product-card').forEach(card=>card.classList.toggle('hidden',family!=='todos'&&card.dataset.family!==family))}));
    let count=0;let toastTimer;const toast=document.getElementById('toast');
    document.querySelectorAll('.quick-add').forEach(button=>button.addEventListener('click',()=>{count+=1;document.getElementById('bagCount').textContent=count;toast.textContent=button.dataset.product+' foi adicionado à sua sacola';toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),2400)}));
    document.getElementById('signup').addEventListener('submit',event=>{event.preventDefault();document.getElementById('signupStatus').textContent='Obrigada! Você entrou para a lista Aura.';event.currentTarget.reset()});
    const menu=document.querySelector('.menu-toggle'),nav=document.getElementById('nav');menu.addEventListener('click',()=>{const isOpen=nav.classList.toggle('open');menu.setAttribute('aria-expanded',isOpen);menu.setAttribute('aria-label',isOpen?'Fechar menu':'Abrir menu')});nav.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{nav.classList.remove('open');menu.setAttribute('aria-expanded','false')}));
    document.querySelector('.search').addEventListener('click',()=>{document.getElementById('colecao').scrollIntoView({behavior:'smooth'});document.querySelector('.filter-row').scrollIntoView({behavior:'smooth',block:'center'})});
